// VibePrint's own icons, on the VibeWare 16-unit grid (1-unit strokes, 0/45/90 degrees,
// axis-aligned strokes on half units). The shared set lives in @vibeware.

export global AppIcons {
    // An admin step (one UAC prompt): a shield, flat top, square shoulders, a 45-degree point.
    out property <string> shield: "M 2.5 2.5 L 14.5 2.5 L 14.5 8.5 L 8.5 14.5 L 2.5 8.5 Z M 8.5 5 L 8.5 10";
    // Add by IP: a printer with a plus.
    out property <string> add: "M 4.5 6.5 L 4.5 2.5 L 10.5 2.5 L 10.5 6.5 M 2.5 6.5 L 12.5 6.5 L 12.5 11.5 L 2.5 11.5 Z M 13.5 10 L 13.5 15 M 11 12.5 L 16 12.5";
    // The journal: a page with lines.
    out property <string> journal: "M 3.5 1.5 L 10.5 1.5 L 13.5 4.5 L 13.5 14.5 L 3.5 14.5 Z M 6 6.5 L 11 6.5 M 6 9.5 L 11 9.5 M 6 12.5 L 9 12.5";
    // Restart: a loop with its arrow.
    out property <string> restart: "M 12.5 4.5 L 4.5 4.5 L 2.5 6.5 L 2.5 10.5 L 4.5 12.5 L 12.5 12.5 L 14.5 10.5 L 14.5 8 M 10 2 L 12.5 4.5 L 10 7";
}
